{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The cockpit window: native notifications (permission check, request, send, and listening for a click on one; nothing else of the plugin), opening GitHub pages and local dev servers (http://localhost or 127.0.0.1 on an explicit port) in the browser, the native picker (open only) for adding a project folder and attaching files, and listening to window events (only the webview's drag-drop events are subscribed: Finder drops). Nothing else (no fs, shell, http).",
  "windows": [
    "main"
  ],
  "permissions": [
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "notification:allow-register-listener",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/*"
        },
        {
          "url": "http://localhost:[0-9]/*"
        },
        {
          "url": "http://localhost:[0-9][0-9]/*"
        },
        {
          "url": "http://localhost:[0-9][0-9][0-9]/*"
        },
        {
          "url": "http://localhost:[0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://localhost:[0-9][0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9]/*"
        },
        {
          "url": "http://127.0.0.1:[0-9][0-9][0-9][0-9][0-9]/*"
        }
      ]
    },
    "dialog:allow-open",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
